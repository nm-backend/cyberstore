# Copy to .env for local development: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-locally
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite (db.sqlite3). On Render this is filled automatically.
DATABASE_URL=

# Optional: photos/videos in Cloudinary. Without it files are stored in ./media (local only).
CLOUDINARY_URL=

# Optional: first admin user (also used by build.sh on Render)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
