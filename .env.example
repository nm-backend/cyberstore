# Copy to .env for local development: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-locally
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite (db.sqlite3). On Render this is filled automatically.
DATABASE_URL=

# Optional: photos/videos in Cloudinary. Without it files are stored in ./media (local only).
CLOUDINARY_URL=

# Optional: Telegram notifications about new leads. Empty — notifications are off.
# Token is given by @BotFather, chat id is the manager's chat (or group) id.
# Several recipients are allowed, comma-separated: 123456789,-1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: first admin user (created by bootstrap_site on start)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
